# Copy to .env and fill in. Never commit .env.

# --- core API -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tutor:CHANGE_ME@localhost:5432/spanish_tutor
ANTHROPIC_API_KEY=
# Comma-separated keys accepted in the X-Client-Key header (one per client app).
CLIENT_API_KEYS=

# LLM. Change the model only on eval evidence (evals/corrections).
TUTOR_MODEL=claude-opus-5-5
TUTOR_EFFORT=low               # low | medium | high | xhigh | max (eval-backed)
TUTOR_HELP_EFFORT=low          # hint/translate/suggest/explain buttons (fast)
TUTOR_MAX_TOKENS=16000
TUTOR_FALLBACKS=default        # default (server-side refusal fallbacks) | off
LLM_TIMEOUT_SECONDS=120

# Learner model
MASTERY_ALPHA=0.2
RECENT_TURNS_IN_PROMPT=12
# Habits: streak day boundaries, daily goal (messages/day), reminder time (learner's local hour).
DEFAULT_TIMEZONE=UTC           # IANA name, e.g. Asia/Bangkok, Europe/Madrid
DEFAULT_DAILY_GOAL=10
REMINDER_HOUR=19
REMINDER_MAX_IDLE_DAYS=7       # stop reminding after this many days without practice
# CURRICULUM_DIR=D:\spanish-tutor\curriculum   # default: <repo>/curriculum

# --- Telegram bot ---------------------------------------------------------
TELEGRAM_TOKEN=
TUTOR_API_URL=http://127.0.0.1:8000
# Key the bot sends as X-Client-Key; defaults to the first CLIENT_API_KEYS entry.
TUTOR_API_KEY=
BOT_TARGET_LANG=es
BOT_DEFAULT_NATIVE_LANG=en
# Language buttons in onboarding/settings (code:label, comma-separated). Optional.
# BOT_NATIVE_LANG_CHOICES=en:English,th:ไทย,ja:日本語

# Postgres superuser (admin only, not used by the app)
POSTGRES_SUPERUSER_PASSWORD=
